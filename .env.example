# =============================================================================
# Lunar Landing Site Navigator — Environment Configuration Template
# =============================================================================
#
# NOTE: Variables prefixed with VITE_ are embedded into public client bundles.
# NEVER include private API keys, secrets, or database credentials here.
#
# -----------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT SETUP (default fallback if left unset in DEV mode):
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# 2. PRODUCTION DEPLOYMENT SETUP (REQUIRED at build time for Vercel/Cloud):
# -----------------------------------------------------------------------------
# In production, VITE_API_BASE_URL MUST be explicitly configured with your
# deployed FastAPI backend domain. If left unset in production builds, the app
# will display a clear configuration notice rather than attempting localhost calls.
#
# Example production URL:
# VITE_API_BASE_URL=https://lunar-navigator-api.yourdomain.com

# -----------------------------------------------------------------------------
# 3. BACKEND (FastAPI) — read from the backend process environment, NOT bundled
#    into the client. Do not prefix with VITE_.
# -----------------------------------------------------------------------------
# Query the public NASA/JPL Horizons API live for Sun/Earth angles; no API key
# is required. Local run scripts set this to 1. If a live query fails, the
# backend attempts a matching recorded fixture.
ENABLE_LIVE_HORIZONS=1

# Max horizon search radius (m) for the terrain-aware engine (default 5000).
# TERRAIN_MAX_RADIUS_M=5000
